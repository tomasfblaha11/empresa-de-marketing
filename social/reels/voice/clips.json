{
 "reel-01-five-seconds-en": [
  {
   "at": 0.15,
   "end": 3.02,
   "file": "social/reels/voice/clips/9fdb251bceb3.mp3",
   "text": "Quick game: find the phone number. Five seconds!"
  },
  {
   "at": 3.2,
   "end": 3.7,
   "file": "social/reels/voice/clips/e6de0760e93d.mp3",
   "text": "Three!"
  },
  {
   "at": 4.2,
   "end": 4.64,
   "file": "social/reels/voice/clips/519f835a7a6a.mp3",
   "text": "Two!"
  },
  {
   "at": 5.2,
   "end": 5.64,
   "file": "social/reels/voice/clips/7e6048a1ae39.mp3",
   "text": "One!"
  },
  {
   "at": 6.4,
   "end": 9.17,
   "file": "social/reels/voice/clips/3e133e9f893a.mp3",
   "text": "Time's up! They already called the next business."
  },
  {
   "at": 9.4,
   "end": 13.66,
   "file": "social/reels/voice/clips/e630df57f8bf.mp3",
   "text": "Same cottage, done right: one tap, and they call you."
  },
  {
   "at": 13.81,
   "end": 15.51,
   "file": "social/reels/voice/clips/175e7e78058e.mp3",
   "text": "Is your number one tap away?"
  }
 ],
 "reel-01-five-seconds-es": [
  {
   "at": 0.15,
   "end": 3.57,
   "file": "social/reels/voice/clips/7f8a10cb8404.mp3",
   "text": "Juego rápido: encontrá el teléfono. ¡Cinco segundos!"
  },
  {
   "at": 3.72,
   "end": 4.32,
   "file": "social/reels/voice/clips/6ef508050587.mp3",
   "text": "¡Tres!"
  },
  {
   "at": 4.47,
   "end": 4.91,
   "file": "social/reels/voice/clips/3b58cedf3cdc.mp3",
   "text": "¡Dos!"
  },
  {
   "at": 5.2,
   "end": 5.93,
   "file": "social/reels/voice/clips/b8809663f3b5.mp3",
   "text": "¡Uno!"
  },
  {
   "at": 6.4,
   "end": 9.74,
   "file": "social/reels/voice/clips/b8fd11403ab9.mp3",
   "text": "¡Tiempo! Tu cliente ya llamó a otro negocio."
  },
  {
   "at": 9.89,
   "end": 13.49,
   "file": "social/reels/voice/clips/2c0c6f69d9a0.mp3",
   "text": "La misma cabaña, bien hecha: un toque, y te llaman."
  },
  {
   "at": 13.64,
   "end": 15.44,
   "file": "social/reels/voice/clips/61021c0bed72.mp3",
   "text": "¿Tu teléfono está a un toque?"
  }
 ],
 "reel-02-one-in-eight-en": [
  {
   "at": 0.15,
   "end": 4.41,
   "file": "social/reels/voice/clips/b65485c7c99a.mp3",
   "text": "We checked two thousand seven hundred and ninety small business listings."
  },
  {
   "at": 4.56,
   "end": 8.22,
   "file": "social/reels/voice/clips/d6ba411aed23.mp3",
   "text": "More than one in eight linked to a website that didn't even load."
  },
  {
   "at": 8.37,
   "end": 11.79,
   "file": "social/reels/voice/clips/51d547ee545c.mp3",
   "text": "So... when did you last open yours?"
  },
  {
   "at": 11.94,
   "end": 13.64,
   "file": "social/reels/voice/clips/5b4ed66265d3.mp3",
   "text": "Open it now. I'll wait."
  }
 ],
 "reel-02-one-in-eight-es": [
  {
   "at": 0.15,
   "end": 3.99,
   "file": "social/reels/voice/clips/6c80caa394ff.mp3",
   "text": "Revisamos dos mil setecientos noventa negocios en directorios."
  },
  {
   "at": 4.14,
   "end": 8.32,
   "file": "social/reels/voice/clips/5936ea8d6323.mp3",
   "text": "Más de uno de cada ocho tenía una web que ni siquiera cargaba."
  },
  {
   "at": 8.47,
   "end": 11.63,
   "file": "social/reels/voice/clips/611a4328f4a1.mp3",
   "text": "¿Cuándo fue la última vez que abriste la tuya?"
  },
  {
   "at": 11.78,
   "end": 13.87,
   "file": "social/reels/voice/clips/e94bc7035989.mp3",
   "text": "Abrila ahora. Te espero."
  }
 ],
 "reel-03-which-one-en": [
  {
   "at": 0.15,
   "end": 4.56,
   "file": "social/reels/voice/clips/70770d3c74d6.mp3",
   "text": "Same cottage. Same price. Which one would you book?"
  },
  {
   "at": 4.71,
   "end": 6.88,
   "file": "social/reels/voice/clips/05498e784a80.mp3",
   "text": "A... or B?"
  },
  {
   "at": 7.03,
   "end": 8.6,
   "file": "social/reels/voice/clips/7b0b6e8e3000.mp3",
   "text": "Tell me in the comments!"
  },
  {
   "at": 8.75,
   "end": 12.22,
   "file": "social/reels/voice/clips/c6819b67359e.mp3",
   "text": "If you picked B, so do your guests. In seconds."
  },
  {
   "at": 12.37,
   "end": 13.52,
   "file": "social/reels/voice/clips/46ebacdfa7e0.mp3",
   "text": "Want your own B?"
  }
 ],
 "reel-03-which-one-es": [
  {
   "at": 0.15,
   "end": 4.28,
   "file": "social/reels/voice/clips/5e2ab7100dd6.mp3",
   "text": "La misma cabaña. El mismo precio. ¿Cuál reservarías?"
  },
  {
   "at": 4.43,
   "end": 6.47,
   "file": "social/reels/voice/clips/3b331a10a2fc.mp3",
   "text": "¿La A... o la B?"
  },
  {
   "at": 6.62,
   "end": 9.26,
   "file": "social/reels/voice/clips/fe1a822a03e1.mp3",
   "text": "¡Contame en los comentarios!"
  },
  {
   "at": 9.41,
   "end": 13.49,
   "file": "social/reels/voice/clips/28f32b1bcb2a.mp3",
   "text": "Si elegiste la B, tus huéspedes también. En segundos."
  },
  {
   "at": 13.64,
   "end": 14.92,
   "file": "social/reels/voice/clips/a1701977c282.mp3",
   "text": "¿Querés tu propia B?"
  }
 ]
}