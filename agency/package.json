{
  "name": "ceibo-works-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run examples && astro check && astro build",
    "preview": "astro preview",
    "test": "playwright test --trace off",
    "examples": "npm --prefix ../template ci --no-audit --no-fund && node scripts/build-examples.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.63.0",
    "typescript": "6.0.3"
  }
}
