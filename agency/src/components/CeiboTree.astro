---
// Decorative ceibo tree in soft brush strokes. Pure SVG: the "brush" look comes from a
// turbulence displacement filter, so there is no image to download. Hidden from assistive tech.

// Deterministic pseudo-random so every build draws the same tree.
let seed = 7;
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);

// Foliage clouds at the end of each branch: [cx, cy, rx, ry]
const clouds: [number, number, number, number][] = [
  [470, 205, 95, 62], [150, 245, 92, 58], [352, 112, 86, 64], [300, 62, 62, 44],
  [432, 128, 66, 50], [198, 168, 70, 52], [548, 158, 58, 44], [78, 212, 58, 42],
];

// Flowers scattered inside the clouds, each with its own angle and size.
const flowers = clouds.flatMap(([cx, cy, rx, ry]) =>
  Array.from({ length: 7 }, () => {
    const a = rand() * Math.PI * 2;
    const r = Math.sqrt(rand());
    return {
      x: cx + Math.cos(a) * rx * 0.85 * r,
      y: cy + Math.sin(a) * ry * 0.85 * r,
      rot: Math.round(rand() * 80 - 40),
      s: 0.32 + rand() * 0.22,
    };
  }),
);
---
<svg class="ceibo-tree" viewBox="0 0 600 640" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMax meet">
  <defs>
    <filter id="brush" x="-10%" y="-10%" width="120%" height="120%">
      <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="3" result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="10" />
    </filter>
    <filter id="brush-soft" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="3" seed="9" result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="28" result="d" />
      <feGaussianBlur in="d" stdDeviation="2" />
    </filter>
    <path id="petal" d="M3.5 4.5C-11 -3-12.5-21.5-0.5-30.5 3-19 14-11.5 16.5 1c-4.6 4.2-8.6 5-13 3.5z" />
  </defs>

  <g filter="url(#brush-soft)" class="foliage">
    {clouds.map(([cx, cy, rx, ry]) => <ellipse cx={cx} cy={cy} rx={rx} ry={ry} />)}
  </g>

  <g filter="url(#brush)" class="wood" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path d="M292 640C302 560 268 500 298 430C318 382 300 342 320 300" stroke-width="34" />
    <path d="M296 600C300 540 278 490 304 432" stroke-width="44" opacity="0.6" />
    <path d="M305 332C360 300 400 252 470 232" stroke-width="15" />
    <path d="M300 362C240 332 200 282 140 270" stroke-width="14" />
    <path d="M318 302C330 242 362 192 352 132" stroke-width="12" />
    <path d="M470 232C510 222 540 192 556 160" stroke-width="6" />
    <path d="M140 270C110 262 82 240 64 210" stroke-width="6" />
    <path d="M352 132C346 102 330 82 300 62" stroke-width="5" />
    <path d="M402 256C422 200 442 172 432 122" stroke-width="6" />
    <path d="M212 296C200 242 182 212 192 162" stroke-width="6" />
  </g>

  <g class="flowers">
    {flowers.map((f) => (
      <use href="#petal" transform={`translate(${f.x.toFixed(1)} ${f.y.toFixed(1)}) rotate(${f.rot}) scale(${f.s.toFixed(2)})`} />
    ))}
  </g>
</svg>

<style>
  .ceibo-tree { display: block; width: 100%; height: auto; }
  .foliage { fill: var(--river); opacity: 0.16; }
  .wood { stroke: var(--bark); opacity: 0.72; }
  .flowers { fill: var(--ceibo); opacity: 0.85; }
</style>
