---
import Base from '../layouts/Base.astro';
import Logo from './Logo.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { pages } from '../i18n/niches';
import { Image } from 'astro:assets';
import ceiboPhoto from '../assets/ceibo-flowers.jpg';
import Wheel from './Wheel.astro';
import { t, settings, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t[lang];
const path = lang === 'en' ? '/' : '/es/';
const altPath = lang === 'en' ? '/es/' : '/';
const mail = `mailto:${settings.email}`;
const wa = settings.whatsapp ? `https://wa.me/${settings.whatsapp}?text=${encodeURIComponent(c.contact.waText)}` : '';
const titleWords = c.hero.title.split(' ');

const nicheLinks = pages.filter((p) => p.id !== 'entre-rios' && p[lang]).map((p) => p[lang]!);
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Ceibo Works', url: `${settings.url}/`, inLanguage: lang, publisher: { '@id': `${settings.url}/#business` } };

---
<Base lang={lang} title={c.meta.title} description={c.meta.description} path={path} altPath={altPath} jsonLd={[website]}>
  <SiteHeader lang={lang} onHome enHref="/" esHref="/es/" />

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-inner">
        <h1 id="hero-title" class="reveal-words">
          {titleWords.map((w, i) => <><span style={`--i:${i}`}>{w}</span>{' '}</>)}
        </h1>
        <p class="special" style={`--i:${titleWords.length + 2}`}>{c.hero.special}</p>
        <p class="lead fade" style={`--i:${titleWords.length + 5}`}>{c.hero.lead}</p>
        <div class="actions fade" style={`--i:${titleWords.length + 6}`}>
          <a class="btn btn--primary" href="#contact">{c.hero.cta}</a>
          <a class="btn btn--quiet" href="#work">{c.hero.secondary}</a>
        </div>
        <p class="note fade" style={`--i:${titleWords.length + 7}`}>{c.hero.note}</p>
      </div>
      <figure class="hero-art">
        <Image src={ceiboPhoto} alt={c.hero.photoAlt} widths={[400, 640, 900, 1280]} sizes="(min-width: 56rem) 30vw, 80vw" loading="eager" fetchpriority="high" />
        <figcaption>{c.hero.photoCaption}</figcaption>
      </figure>
    </section>

    <Wheel lang={lang} />

    <section class="draft" aria-labelledby="draft-title">
      <div class="wrap draft-inner">
        <h2 id="draft-title">{c.draft.title}</h2>
        <p>{c.draft.text}</p>
        <a class="btn btn--light" href="#contact">{c.draft.cta}</a>
      </div>
    </section>

    <section class="section" id="how" aria-labelledby="how-title">
      <div class="wrap">
        <h2 id="how-title">{c.steps.title}</h2>
        <ol role="list" class="steps">
          {c.steps.items.map((s, i) => (
            <li>
              <span class="num" aria-hidden="true">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section tinted" aria-labelledby="included-title">
      <div class="wrap split">
        <h2 id="included-title">{c.included.title}</h2>
        <ul role="list" class="checks">
          {c.included.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="section niches" aria-labelledby="niches-title">
      <div class="wrap">
        <h2 id="niches-title">{c.niches.title}</h2>
        <p class="sub">{c.niches.lead}</p>
        <ul role="list" class="niche-list">
          {nicheLinks.map((n) => (
            <li>
              <a href={n.path}>
                <h3>{n.h1}</h3>
                <p>{n.description}</p>
                <span class="more-link">{c.niches.more} <span aria-hidden="true">→</span></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section pricing" id="pricing" aria-labelledby="pricing-title">
      <div class="wrap narrow">
        <h2 id="pricing-title">{c.pricing.title}</h2>
        <p class="sub">{c.pricing.lead}</p>
        <fieldset class="currency">
          <legend>{c.pricing.legend}</legend>
          {settings.currencies.map((cur) => (
            <label>
              <input type="radio" name="currency" value={cur.id} checked={cur.id === c.pricing.defaultCurrency} />
              <span>{cur.label}</span>
            </label>
          ))}
        </fieldset>
        <div class="price-box" aria-live="polite">
          {settings.currencies.map((cur) => (
            <div class="price" data-cur={cur.id}>
              <p class="amount">{cur.price} <small>{c.pricing.per}</small></p>
              <p class="extra">{c.pricing.extra} <strong>{cur.extra}</strong> {c.pricing.per}</p>
            </div>
          ))}
        </div>
        <p class="foot">{c.pricing.foot}</p>
      </div>
    </section>

    <section class="section tinted" id="about" aria-labelledby="about-title">
      <div class="wrap about">
        <div class="portrait" role="img" aria-label={c.about.photoAlt}><span>TB</span></div>
        <div>
          <h2 id="about-title">{c.about.title}</h2>
          {c.about.text.map((p) => <p class="story">{p}</p>)}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="faq-title">
      <div class="wrap narrow">
        <h2 id="faq-title">{c.faq.title}</h2>
        <div class="faq">
          {c.faq.items.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section contact tinted" id="contact" aria-labelledby="contact-title">
      <div class="wrap narrow">
        <Logo size={56} withName={false} />
        <h2 id="contact-title">{c.contact.title}</h2>
        <p class="sub">{c.contact.lead}</p>
        <div class="actions">
          <a class="btn btn--primary" href={mail}>{c.contact.email}: {settings.email}</a>
          {wa && <a class="btn btn--quiet" href={wa} rel="noopener">{c.contact.whatsapp}</a>}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} photoCredit />
</Base>

<style>


  /* Hero: one orchestrated entrance. Words rise in, then the special line is drawn in. */
  .hero { position: relative; overflow: hidden; padding-block: clamp(3rem, 2rem + 6vw, 7rem) 0; }
  .hero-art { width: min(82%, 22rem); margin: 2.5rem 0 3rem auto; }
  .hero-art :global(img) {
    width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 35%;
    border-radius: 999px 999px 14px 14px;
    box-shadow: 0 30px 60px -36px rgb(155 12 35 / 0.55);
    animation: rise 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both 300ms;
  }
  .hero-art figcaption { margin-top: 0.9rem; font-size: var(--step--1); color: var(--muted); max-width: 30ch; }
  .hero-inner { position: relative; }
  h1 { font-size: var(--step-4); font-weight: 640; font-stretch: 92%; max-width: 18ch; }
  .reveal-words span { display: inline-block; animation: rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(var(--i) * 70ms); }
  .special {
    position: relative; display: inline-block; margin-top: 1.5rem;
    font-size: var(--step-2); font-weight: 600; color: var(--ceibo); line-height: 1.25; max-width: 26ch;
    animation: rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(var(--i) * 70ms);
  }
  .special::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -0.35rem; height: 3px; border-radius: 3px;
    background: var(--ceibo); transform-origin: left; transform: scaleX(0);
    animation: draw 900ms cubic-bezier(0.6, 0, 0.2, 1) forwards; animation-delay: calc(var(--i) * 70ms + 500ms);
  }
  .fade { animation: rise 700ms ease both; animation-delay: calc(var(--i) * 70ms); }
  .lead { margin-top: 1.5rem; font-size: var(--step-1); color: var(--muted); max-width: 40ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .note { margin-top: 1rem; font-size: var(--step--1); color: var(--muted); }
  @keyframes rise { from { opacity: 0; transform: translateY(0.6em); } to { opacity: 1; transform: none; } }
  @keyframes draw { to { transform: scaleX(1); } }
  @media (prefers-reduced-motion: reduce) {
    .reveal-words span, .special, .fade, .hero-art :global(img) { animation: none; }
    .special::after { animation: none; transform: scaleX(1); }
  }
  @media (min-width: 56rem) {
    .hero { padding-bottom: clamp(4rem, 3rem + 5vw, 7rem); }
    .hero-art { position: absolute; right: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))); top: 50%; transform: translateY(-50%); width: min(30vw, 24rem); margin: 0; }
    .hero-inner > * { max-width: 34rem; }
  }

  .draft { background: var(--ceibo); color: #fff; padding-block: clamp(3rem, 2rem + 4vw, 5rem); }
  .draft-inner { display: grid; gap: 1rem; justify-items: start; }
  .draft p { font-size: var(--step-1); opacity: 0.95; }
  .btn--light { background: #fff; color: var(--ceibo-dark); margin-top: 0.5rem; }
  .btn--light:hover { background: var(--paper-2); }

  .steps { display: grid; gap: 2rem; margin-top: 2.5rem; }
  .steps li { position: relative; padding-top: 3.25rem; }
  .num { position: absolute; top: 0; left: 0; width: 2.4rem; height: 2.4rem; border-radius: 50%; display: grid; place-items: center; background: var(--ceibo); color: #fff; font-weight: 650; }
  .steps p { margin-top: 0.5rem; color: var(--muted); }
  @media (min-width: 48rem) { .steps { grid-template-columns: repeat(3, 1fr); gap: 2.5rem; } }

  .tinted { background: var(--paper-2); }
  .split { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 56rem) { .split { grid-template-columns: 1fr 1.2fr; gap: 4rem; } }
  .checks { display: grid; gap: 0.9rem; }
  .checks li { position: relative; padding-left: 2rem; }
  .checks li::before { content: ''; position: absolute; left: 0.15rem; top: 0.45em; width: 0.95rem; height: 0.55rem; border-left: 2.5px solid var(--river); border-bottom: 2.5px solid var(--river); transform: rotate(-45deg); }

  .sub { margin-top: 1rem; color: var(--muted); font-size: var(--step-1); line-height: 1.45; }
  .narrow { max-width: 46rem; }

  /* Currency switch: pure CSS with :has(), no JavaScript needed. */
  .currency { display: inline-flex; gap: 4px; margin: 2rem 0 0; padding: 4px; border: 1px solid var(--line); border-radius: 999px; background: #fff; }
  .currency legend { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .currency label { position: relative; cursor: pointer; }
  .currency input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .currency span { display: grid; place-items: center; min-width: 4.5rem; min-height: 2.6rem; border-radius: 999px; font-weight: 650; color: var(--muted); }
  .currency input:checked + span { background: var(--ceibo); color: #fff; }
  .currency input:focus-visible + span { outline: 3px solid var(--focus); outline-offset: 2px; }
  .price-box { margin-top: 1.75rem; padding: 1.75rem; border-radius: var(--radius); background: #fff; border: 1px solid var(--line); }
  .price { display: none; }
  .pricing:has(input[value='nzd']:checked) [data-cur='nzd'],
  .pricing:has(input[value='usd']:checked) [data-cur='usd'],
  .pricing:has(input[value='ars']:checked) [data-cur='ars'] { display: block; }
  .amount { font-size: var(--step-4); font-weight: 650; color: var(--ink); font-variant-numeric: tabular-nums; line-height: 1; }
  .amount small { font-size: var(--step-0); font-weight: 500; color: var(--muted); }
  .extra { margin-top: 0.9rem; color: var(--muted); }
  .extra strong { color: var(--ink); }
  .foot { margin-top: 1.25rem; font-size: var(--step--1); color: var(--muted); }

  .about { display: grid; gap: 2rem; align-items: start; }
  .portrait { width: 9rem; aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center; background: var(--river); color: #fff; font-size: 2.2rem; font-weight: 650; }
  .story { margin-top: 1.1rem; font-size: var(--step-1); line-height: 1.5; }
  @media (min-width: 48rem) { .about { grid-template-columns: auto 1fr; gap: 3rem; } .portrait { width: 12rem; } }

  .faq { margin-top: 2rem; border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; padding-block: 1.1rem; font-weight: 600; font-size: var(--step-1); list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--ceibo); font-weight: 500; }
  details[open] summary::after { content: '−'; }
  details p { padding-bottom: 1.2rem; color: var(--muted); }

  .contact h2 { margin-top: 1.25rem; }

  .niches { padding-bottom: 0; }
  .niche-list { display: grid; gap: 1.25rem; margin-top: 2.5rem; }
  .niche-list a { display: grid; gap: 0.6rem; height: 100%; padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; text-decoration: none; color: inherit; transition: border-color 0.12s, box-shadow 0.12s; }
  .niche-list a:hover { border-color: var(--ink); box-shadow: 0 16px 34px -26px rgb(31 36 33 / 0.5); }
  .niche-list p { color: var(--muted); font-size: var(--step--1); }
  .more-link { align-self: end; color: var(--ceibo-dark); font-weight: 650; }
  @media (min-width: 48rem) { .niche-list { grid-template-columns: repeat(3, 1fr); } }
</style>
