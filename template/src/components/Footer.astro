---
import { site, link } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap row">
    <p>© {year} <span translate="no">{site.legal.responsible}</span></p>
    <nav aria-label="Legal">
      <a href={link('privacy/')}>Privacy</a>
    </nav>
    {site.credit && <p class="made">Website by <a href="https://ceiboworks.com/">Ceibo Works</a></p>}
    {site.demo && <p class="credit">Demo photos: public domain (CC0), Wikimedia Commons.</p>}
  </div>
</footer>

<style>
  .footer { background: var(--ink); color: #c9ced2; font-size: var(--step--1); padding-block: 2rem 6rem; }
  .row { display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; align-items: center; }
  .credit { flex-basis: 100%; opacity: 0.8; }
  .made { margin-left: auto; }
  .made a { color: inherit; }
  @media (min-width: 48rem) { .footer { padding-bottom: 2rem; } }
</style>
