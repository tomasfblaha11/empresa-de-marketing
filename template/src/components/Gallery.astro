---
import { Picture } from 'astro:assets';
import { site, preset, img } from '../lib/site';
const photos = site.photos.gallery;
---
<section class="section work" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <h2 id="work-title">{preset.copy.workTitle}</h2>
    <ul class="grid" role="list">
      {photos.map((p, i) => (
        <li class:list={['tile', { lead: i === 0 }]}>
          <figure>
            <Picture
              src={img(p.file)}
              alt={p.alt}
              widths={i === 0 ? [640, 960, 1440] : [480, 720, 960]}
              sizes={i === 0 ? '(min-width: 56rem) 66vw, 100vw' : '(min-width: 56rem) 33vw, 100vw'}
              formats={['avif', 'webp']}
              loading="lazy"
            />
            {p.caption && <figcaption>{p.caption}</figcaption>}
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .work { background: var(--paper-2); }
  .grid { display: grid; gap: 1rem; margin-top: 2rem; }
  figure :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); }
  figcaption { margin-top: 0.5rem; font-size: var(--step--1); font-weight: 600; color: var(--ink-soft); }
  @media (min-width: 40rem) {
    .grid { grid-template-columns: repeat(2, 1fr); }
    .lead { grid-column: 1 / -1; }
    .lead :global(img) { aspect-ratio: 16 / 9; }
  }
  @media (min-width: 56rem) {
    .grid { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    .lead { grid-column: span 2; grid-row: span 2; }
    .lead figure { height: 100%; display: grid; grid-template-rows: 1fr auto; }
    .lead :global(picture) { display: block; position: relative; min-height: 0; }
    .lead :global(img) { position: absolute; inset: 0; height: 100%; aspect-ratio: auto; }
    /* After the lead block, rows hold 3 photos: stretch a lone or paired last row. */
    .tile:last-child:nth-child(3n + 1):not(.lead) { grid-column: 1 / -1; }
    .tile:last-child:nth-child(3n + 1):not(.lead) :global(img) { aspect-ratio: 21 / 8; }
    .tile:last-child:nth-child(3n + 2) { grid-column: span 2; }
    .tile:last-child:nth-child(3n + 2) :global(img) { aspect-ratio: 16 / 7; }
  }
</style>
