---
import Icon from './Icon.astro';
import { site, preset, tel, whatsappUrl } from '../lib/site';
const c = site.contact;
---
<nav class="mobile-bar" aria-label="Quick contact">
  <a href={tel(c.phone)}><Icon name="phone" />Call</a>
  {c.whatsapp && <a href={whatsappUrl(c.whatsapp, `Hi ${site.business.name}, I'd like a quote.`)} rel="noopener"><Icon name="whatsapp" />WhatsApp</a>}
  <a class="primary" href="#contact">{preset.copy.quoteCta}</a>
</nav>

<style>
  .mobile-bar {
    position: fixed; inset: auto 0 0 0; z-index: 50;
    display: flex; gap: 1px; background: var(--rule);
    border-top: 1px solid var(--rule);
    padding-bottom: env(safe-area-inset-bottom);
  }
  a {
    flex: 1; display: flex; align-items: center; justify-content: center; gap: 0.4rem;
    min-height: 3.5rem; background: var(--paper); color: var(--ink);
    font-weight: 700; text-decoration: none; font-size: var(--step--1);
  }
  a :global(svg) { width: 1.15rem; height: 1.15rem; }
  .primary { flex: 1.4; background: var(--accent); color: var(--accent-ink); }
  @media (min-width: 48rem) { .mobile-bar { display: none; } }
</style>
