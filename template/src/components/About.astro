---
import { Picture } from 'astro:assets';
import { site, preset, img } from '../lib/site';
const { story, photo, photoAlt } = site.about;
---
<section class="section" id="about" aria-labelledby="about-title">
  <div class:list={['wrap', 'grid', { 'has-photo': photo }]}>
    {photo && (
      <Picture
        class="photo"
        src={img(photo)}
        alt={photoAlt ?? ''}
        widths={[480, 720, 960]}
        sizes="(min-width: 56rem) 40vw, 100vw"
        formats={['avif', 'webp']}
        loading="lazy"
      />
    )}
    <div>
      <h2 id="about-title">{preset.copy.aboutTitle}</h2>
      <p class="story">{story}</p>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: 2rem; align-items: center; }
  .grid :global(.photo) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius); }
  .story { margin-top: 1.25rem; font-size: var(--step-1); line-height: 1.5; }
  @media (min-width: 40rem) and (max-width: 55.99rem) {
    .grid :global(.photo) { aspect-ratio: 16 / 9; }
  }
  @media (min-width: 56rem) {
    .has-photo { grid-template-columns: 5fr 7fr; gap: 4rem; }
  }
</style>
