---
import { site, preset } from '../lib/site';
const g = site.googleReviews;
---
{site.reviews.length > 0 && (
  <section class="section reviews" aria-labelledby="reviews-title">
    <div class="wrap">
      <h2 id="reviews-title">{preset.copy.reviewsTitle}</h2>
      <ul class="list" role="list">
        {site.reviews.map((r) => (
          <li>
            <figure>
              <blockquote><p>{r.quote}</p></blockquote>
              <figcaption>{r.author}{r.place && <span>, {r.place}</span>}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
      {g.url && g.count && (
        <p class="more"><a href={g.url} rel="noopener">Read all {g.count} reviews on Google</a></p>
      )}
    </div>
  </section>
)}

<style>
  .reviews { background: var(--paper-2); }
  .list { display: grid; gap: 2.5rem; margin-top: 2rem; }
  blockquote p {
    font-size: var(--step-2); line-height: 1.3; font-weight: 500; max-width: 30ch;
  }
  blockquote p::before { content: '“'; }
  blockquote p::after { content: '”'; }
  figcaption { margin-top: 1rem; font-weight: 700; }
  figcaption span { font-weight: 400; color: var(--ink-soft); }
  figure { border-left: 4px solid var(--accent); padding-left: 1.25rem; }
  .more { margin-top: 2.5rem; font-weight: 600; }
  @media (min-width: 56rem) { .list { grid-template-columns: repeat(2, 1fr); gap: 4rem; } }
</style>
