---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, tel, link } from '../lib/site';
---
<Base title={`Page not found | ${site.business.name}`} description="This page does not exist." path="/404/">
  <Header />
  <main id="main" class="wrap section">
    <h1>This page does not exist</h1>
    <p>The link may be old. Go to the <a href={link()}>home page</a> or call <a href={tel(site.contact.phone)}>{site.contact.phone}</a>.</p>
  </main>
  <Footer />
</Base>

<style>
  h1 { font-size: var(--step-4); font-stretch: var(--wide); }
  p { margin-top: 1rem; font-size: var(--step-1); }
</style>
